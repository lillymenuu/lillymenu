# URL base da API PHP (Hostinger em producao, XAMPP local em dev), sem barra no final.
PHP_API_BASE_URL=https://lillymenu.com

# Mesma origem, mas exposta ao navegador (prefixo NEXT_PUBLIC_) — usada pelo
# sidebar para linkar telas do admin que ainda nao foram migradas pro Next.js.
NEXT_PUBLIC_PHP_ADMIN_URL=https://lillymenu.com/admin
