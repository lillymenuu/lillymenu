<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Painel administrativo tem conteudo por usuario/loja logado — nunca pode ser
# guardado no cache do servidor (LiteSpeed) nem repassado a outra pessoa.
# /public tambem e dinamico por loja/sessao (loja.php: status aberto-fechado,
# pausa programada, carrinho; APIs) e precisa da mesma exclusao. Inclui a
# pasta toda (nao so loja.php) porque a loja tambem e acessada por URLs
# reescritas (ex: /nomedaloja, /lilly/nomedaloja) que nao tem "/public" visivel
# na URL original — so a pasta toda garante que o cache nao pegue essas rotas.
<IfModule LiteSpeed>
  CacheDisable public /admin
  CacheDisable public /public
</IfModule>

RewriteEngine On

# Paginas do admin/superadmin sem .php visivel na URL (ex: /admin/dashboard -> admin/dashboard.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(admin/.+)$ $1.php [L,QSA]

# Tela inicial do site (landing page): /public/home -> /public/index.php
RewriteRule ^public/home/?$ public/index.php [L,QSA]

# Formato antigo, mantido por compatibilidade com links ja compartilhados
RewriteRule ^lilly/([^/]+)/?$ public/loja.php?loja=$1 [L,QSA]

# Formato curto: dominio.com/nomedaloja -> so entra se nao for um arquivo/pasta real do projeto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_.-]+)/?$ public/loja.php?loja=$1 [L,QSA]
